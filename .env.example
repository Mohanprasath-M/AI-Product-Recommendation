# ==============================================================================
# NexusAI Platform — Environment Variables
# Copy this file to '.env' and update the values as needed for your environment.
# ==============================================================================

# Application Environment (development / staging / production)
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: MySQL (Recommended for MySQL Workbench)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_recommendation_db

# Option B: SQLite (Zero-config local development without MySQL server installed)
# Uncomment the line below to use SQLite:
# DATABASE_URL=sqlite:///./ai_recommendation.db

# ------------------------------------------------------------------------------
# 2. REDIS / EVENT STREAMING (Optional - fallback to In-Memory TTL cache)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
SECRET_KEY=NEXUSAI_SUPER_SECRET_PRODUCTION_KEY_CHANGE_IN_ENV_XYZ987654321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 4. HYBRID RECOMMENDER DEFAULT WEIGHTS (Dynamic A/B tunable)
# ------------------------------------------------------------------------------
WEIGHT_CONTENT=0.35
WEIGHT_COLLABORATIVE=0.30
WEIGHT_BEHAVIOR=0.15
WEIGHT_POPULARITY=0.08
WEIGHT_RATING=0.05
WEIGHT_PERSONALIZATION=0.07
